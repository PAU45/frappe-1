# Frappe/ERPNext Environment Variables
# Copy this file to .env and fill in the values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=frappe
DB_USER=frappe
DB_PASSWORD=your_secure_password_here
DB_ROOT_PASSWORD=your_root_password_here

# Redis Configuration
REDIS_CACHE=redis://localhost:6379/0
REDIS_QUEUE=redis://localhost:6379/1
REDIS_SOCKETIO=redis://localhost:6379/2

# Frappe Configuration
FRAPPE_SITE=site1.localhost
ADMIN_PASSWORD=admin

# Gunicorn Configuration
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
WORKERS_CLASS=gthread

# Render Specific (auto-set by Render)
PORT=8000
